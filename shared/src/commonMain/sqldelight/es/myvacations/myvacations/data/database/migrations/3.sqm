ALTER TABLE SettingsData
ADD COLUMN firstLogin INTEGER NOT NULL DEFAULT 1;

ALTER TABLE SettingsData
ADD COLUMN iaTutorial INTEGER NOT NULL DEFAULT 1;

ALTER TABLE SettingsData
ADD COLUMN modelStage TEXT;

CREATE TABLE ChatMessageData (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    userText TEXT NOT NULL,
    userElementsFound TEXT NOT NULL,
    userRetryOn INTEGER AS kotlin.Boolean NOT NULL,
    mainLocationLongitude REAL NOT NULL,
    mainLocationLatitude REAL NOT NULL,
    botText TEXT,
    botElementsFound TEXT,
    botRetryOn INTEGER AS kotlin.Boolean,
    whatAsk TEXT NOT NULL,
    label TEXT NOT NULL,
    subcategory TEXT NOT NULL,
    labelConfidence REAL NOT NULL,
    subcategoryConfidence REAL NOT NULL,
    elementsSizeFound INTEGER NOT NULL,
    time TEXT NOT NULL,
    feedbackDone INTEGER AS kotlin.Boolean NOT NULL
);