)
VALUES (
?,
?,
?,
?,
?,
?,
?,
?,
?,
?,
?,
?,
?,
?,
?,
?
);

updateFeedback:
UPDATE ChatMessageData
SET
    feedbackDone = ?
WHERE id = ?;

deleteMessage:
